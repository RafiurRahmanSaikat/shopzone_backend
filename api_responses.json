{
  "AUTH": {
    "note": "POST /api/token/ — returns access + refresh JWT tokens",
    "login": {
      "method": "POST",
      "endpoint": "/api/token/",
      "body": {
        "username": "string",
        "password": "string"
      },
      "response": {
        "access": "<JWT_ACCESS_TOKEN>",
        "refresh": "<JWT_REFRESH_TOKEN>"
      }
    },
    "logout": {
      "method": "POST",
      "endpoint": "/api/logout/",
      "auth": "Bearer <access_token>",
      "body": {
        "refresh": "<refresh_token>"
      },
      "response": {
        "error": "Expecting value: line 2 column 1 (char 1)"
      }
    }
  },
